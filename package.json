{
  "name": "@marcinwalendowski/script-harbor",
  "version": "0.1.0",
  "description": "Inventory, review, pin and self-host third-party browser scripts.",
  "type": "module",
  "bin": {
    "script-harbor": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/pipeline.js",
    "./integrations": "./dist/integrations.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test test/*.e2e.ts",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test:live": "tsx scripts/live-vendors.ts",
    "test:package": "npm run build && tsx scripts/package-smoke.ts",
    "test:frameworks": "npm run build && tsx scripts/framework-smoke.ts"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.3",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcinWalendowski/script-harbor.git"
  },
  "license": "MIT"
}
